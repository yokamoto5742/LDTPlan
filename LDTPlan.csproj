<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LDTPlan</RootNamespace>
    <AssemblyName>LDTPlan</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefaultItemExcludes>$(DefaultItemExcludes);LDTPlan.Tests\**</DefaultItemExcludes>
    <ApplicationIcon>LDTPlan.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LDTPlan.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LDTPlan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".claude\agents\changelog-updater.md" />
    <None Include=".claude\agents\japanese-comment-reviewer.md" />
    <None Include=".claude\agents\pyright-type-checker.md" />
    <None Include=".claude\agents\pytest-test-creator.md" />
    <None Include=".claude\agents\readme-generator.md" />
    <None Include=".claude\hooks\permission-request-notification.ps1" />
    <None Include=".claude\hooks\stop-notification.ps1" />
    <None Include=".claude\rules\coding-guidelines.md" />
    <None Include=".claude\rules\commit.md" />
    <None Include=".claude\rules\response-style.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="CopyToDeployFolder" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)LDTPlan.exe;$(PublishDir)e_sqlite3.dll;$(PublishDir)config.ini" DestinationFolder="C:\Shinseikai\LDTPlan" />
  </Target>

</Project>
